# ─── Local Development ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Security (CHANGE THESE before production!) ───────────────────────────────
# Shared secret sent by the Flutter app in X-Telemetry-Key header.
# Must match --dart-define=TELEMETRY_API_KEY=... in Flutter build.
TELEMETRY_API_KEY=local-dev-telemetry-key-change-in-production

# Admin login (env-based fallback — create a DB admin user for production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT signing secret — min 32 characters, random string
JWT_SECRET=local-dev-jwt-secret-min-32-characters-long

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave blank for SQLite (local dev only).
# Set to a PostgreSQL connection string for production (Railway / Neon / Vercel Postgres).
# Example: postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Session timeout in hours (default: 12)
# SESSION_TIMEOUT_HOURS=12
